# Public site origin, used for canonical URLs, sitemap and Open Graph.
# Domain confirmed by the storefront signage (www.pittridgepharmacy.com).
NEXT_PUBLIC_SITE_URL=https://www.pittridgepharmacy.com

# HMAC secret for signed upload URLs. Use a long random value in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
UPLOAD_SIGNING_SECRET=

# Days before uploaded files and request records are purged. Confirm with the pharmacy.
RETENTION_DAYS=30

# Bearer token required by POST /api/internal/retention (call it from a scheduled job).
INTERNAL_CRON_TOKEN=
